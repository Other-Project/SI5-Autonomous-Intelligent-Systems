<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="myBox">
    <static>true</static>
    <pose>2 2 0.9 0 0 0</pose>

    <link name="link">
      <visual name="imageFace">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.01 1.0 1.8</size>
          </box>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
        </material>
      </visual>
    </link>

    <plugin
      filename="libros_video_texture_plugin.so"
      name="video_texture_plugin::VideoTexturePlugin">
      
      <video_path>/home/jilia/SAI5/src/video_publisher/video_publisher/video.mp4</video_path>
      
      <topic>/video_stream</topic>
      
      <fps>30</fps>
    </plugin>

  </model>
</sdf>